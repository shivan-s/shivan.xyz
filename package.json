{
	"name": "shivan.xyz",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"lint-staged": {
		"**/*": "prettier --write --ignore-unknown"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.21.0",
			"onFail": "download"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --fail-on-warnings",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"new": "node ./scripts/new.ts",
		"new:post": "new post",
		"new:presentation": "new presentation",
		"new:gallery": "new gallery"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^3.1.0",
		"@inlang/paraglide-js-svelte": "^1.0.5",
		"@lucide/svelte": "^1.43.0",
		"@mdsvex/plugin-anchors": "^0.1.1",
		"@mdsvex/plugin-code-blocks": "^0.1.1",
		"@mdsvex/plugin-external-links": "^0.1.1",
		"@mdsvex/plugin-link-check": "^0.1.1",
		"@mdsvex/plugin-page-data": "^0.1.1",
		"@mdsvex/plugin-toc": "^0.1.1",
		"@mdsvex/prettier-plugin": "^0.1.1",
		"@playwright/test": "^1.63.0",
		"@qr-platform/qr-code.js": "^0.20.14",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/sveltekit": "^10.6.5",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.5.0",
		"date-fns": "^4.4.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.3",
		"eslint-plugin-svelte": "^3.23.1",
		"fast-xml-builder": "^1.3.1",
		"fuse.js": "^7.5.0",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"maplibre-gl": "^6.19.0",
		"mdsvex": "^1.0.1",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-sort-json": "^4.2.0",
		"prettier-plugin-svelte": "^4.1.1",
		"reveal.js": "^6.0.2",
		"storybook": "^10.6.5",
		"stylelint": "^17.16.0",
		"stylelint-config-standard": "^40.0.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.5",
		"zod": "^4.6.7"
	}
}
